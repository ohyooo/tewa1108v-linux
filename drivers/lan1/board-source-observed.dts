	aliases {
		console = "/uart1@10119000";
		serial0 = "/uart1@10119000";
		serial1 = "/uart0@10118000";
		spi0 = "/spi1@11834000";
	};

	chosen {
		linux,initrd-start = <0x88000000>;
		linux,initrd-end = <0x8ae9ddfd>;
		bootargs = "console=ttyAMA0,115200 earlycon=pl011,mmio32,0x10119000 keep_bootcon ignore_loglevel maxcpus=1 rdinit=/init";
		linux,stdout-path = "/uart1@10119000";
		stdout-path = "/uart1@10119000:115200n8";
	};

	secure-chosen {
		stdout-path = "console:115200n8";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
		cpu_on = <0x84000003>;
		cpu_off = <0x84000002>;
		cpu_suspend = <0x84000001>;
		system_reset = <0x84000009>;
		system_suspend = <0x8400000e>;
		psci_stat_count = <0x84000011>;
		psci_stst_residency = <0x84000010>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			scu = <0x99>;
			cpu-supply = <0x9a>;
			clocks = <0x05 0x9b 0x06>;
			clock-names = "pclk", "mux", "aclk";
			operating-points-v2 = <0x9c>;
			phandle = <0x180>;
		};

		cpu1: cpu@100 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x100>;
			enable-method = "psci";
			scu = <0x99>;
			cpu-supply = <0x9a>;
			clocks = <0x05 0x9b 0x06>;
			clock-names = "pclk", "mux", "aclk";
			operating-points-v2 = <0x9c>;
			phandle = <0x181>;
		};
	};

	scu: scu@0 {
		clocks = <0x06 0x9d 0x09 0x08>;
		clock-names = "aclk", "mux";
		scu-cpufreq-table = <0x00 0x3b9aca00 0x00 0x4190ab00>;
		phandle = <0x99>;
	};

	cpu0_opp_table_ss: opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x9c>;

		opp-1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-microvolt = <0xdcf28>;
			clock-latency-ns = <0x49da40>;
			opp-suspend;
		};

		opp-1100000000 {
			opp-hz = <0x00 0x4190ab00>;
			opp-microvolt = <0xe6b68>;
			clock-latency-ns = <0x49da40>;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		mem_reserved: mem@0x80000000 {
			compatible = "hsan,mem_reserved";
			reg = <0x80000000 0x200000>;
			no-map;
			phandle = <0x182>;
		};

		flashinfo_reserved: flashinfo@0x80200000 {
			compatible = "hsan,flashinfo_reserved";
			reg = <0x80200000 0x4000>;
			atag-offset = <0x1000>;
			phandle = <0x183>;
		};

		atf_reserved: atf@0x8E400000 {
