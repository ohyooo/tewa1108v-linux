/dts-v1/;

/ {
	compatible = "hsan,tiangong0";
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;

	apb_clk: apb_clk@100000000 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "apb_clk";
		phandle = <0x0b>;
	};

	fixed_clk50m: fixed_clk@50000000 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
