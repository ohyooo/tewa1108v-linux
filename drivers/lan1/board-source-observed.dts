				alert0: trip-point@0 {
					temperature = <0x1adb0>;
					hysteresis = <0xbb8>;
					type = "passive";
					phandle = <0x10f>;
				};

				critical: trip-point@2 {
					temperature = <0x1e848>;
					hysteresis = <0xbb8>;
					type = "critical";
					phandle = <0x1ab>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x10f>;
					cooling-device = <0x110 0x00 0x03>;
					contribution = <0x64>;
				};
			};
		};
	};

	net_cdev: cooling_dev0 {
		compatible = "hsan,net-cdev";
		car-rate-table = <0x00 0x7a120 0x1e848 0x7d00>;
		#cooling-cells = <0x02>;
		dev-names = "eth0", "eth1", "eth2", "eth3", "eth4", "eth5", "pon";
		phandle = <0x110>;
		status = "disabled";
	};

	cpu_supply: reg@0 {
		compatible = "pwm-regulator";
		pwms = <0x111 0x00 0x2710>;
		regulator-min-microvolt = <0x83d60>;
		regulator-max-microvolt = <0xfde80>;
		regulator-name = "vdd_logic";
		pwm-dutycycle-unit = <0x3c>;
		pwm-dutycycle-range = <0x3c 0x00>;
		phandle = <0x9a>;
	};

	pmupwm: pmupwm@0 {
		compatible = "hsan,pmu-pwm";
		reg = <0x11a00640 0x04>;
		clocks = <0x112>;
		#pwm-cells = <0x02>;
		hwver = <0x20>;
		npwm = <0x01>;
		pinctrl-names = "enable";
		pinctrl-0 = <0x113>;
		phandle = <0x111>;
		status = "disabled";
	};

	dying_gasp {
		compatible = "hsan,dying_gasp";
		reg = <0x1012b200 0x20>;
		interrupts = <0x00 0x01 0x04>;
		dyinggasp-reset-attr = <0x10128004 0x08 0x1820027c 0x12345678 0x1820027c 0xedcba987>;
		status = "disabled";
	};

	rstinfo@0x18200000 {
		compatible = "hsan,rstinfo";
		reg = <0x18200000 0x1000>;
		reg-offset = <0x284>;
		record_addr = <0x10100c1c>;
		hwver = <0x20>;
		rstinfo-mask = <0x07>;
		rstinfo-offset = <0x00>;
		rstinfo-type = <0x03>;
		rstinfo-item = "hard";
		status = "disabled";
	};

	gpiopwm_ctrl: gpiopwm_ctrl@11a00240 {
		compatible = "syscon";
		reg = <0x11a00240 0x40>;
		phandle = <0x114>;
	};

	gpio_pwm1 {
		compatible = "hsan,gpio-pwm";
		ctrl-offset = <0x00>;
		syscon = <0x114>;
		gpios = <0xc4>;
		status = "disabled";
	};

	gpio_pwm2 {
		compatible = "hsan,gpio-pwm";
		syscon = <0x114>;
		ctrl-offset = <0x04>;
		gpios = <0x115>;
		status = "disabled";
	};

	twd_clk_modifier: clk_modifier@0 {
		compatible = "hsan,hsan-clk-modifier";
		clocks = <0xa3>;
		freq_div = <0x19>;
		phandle = <0x1ac>;
		status = "disabled";
	};

