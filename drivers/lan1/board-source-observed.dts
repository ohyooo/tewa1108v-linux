	tewa-uart-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		phandle = <0x1ad>;
	};

	tewa-fmc-gates@10108218 {
		compatible = "hsan,tewa-fmc-gates-observer";
		reg = <0x10108218 0x04>;
		#clock-cells = <0x01>;
		hsan,hwver = <0x01>;
		phandle = <0x1ae>;
		status = "okay";
	};
