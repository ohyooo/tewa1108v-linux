				reg = <0x80000 0x100000>;
			};

			partition@2 {
				label = "ubootb";
				reg = <0x180000 0x100000>;
			};

			partition@3 {
				label = "enva";
				reg = <0x280000 0x80000>;
			};

			partition@4 {
				label = "envb";
				reg = <0x300000 0x80000>;
